<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>SAINPersonalityMixer</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>Chazut</Authors>
    <Description>Configurable SAIN personality probabilities for PMCs.</Description>
    <SptRoot Condition="'$(SptRoot)' == ''">C:\Games\SPT-4.1</SptRoot>
    <SainDirectory Condition="'$(SainDirectory)' == ''">$(SptRoot)\BepInEx\plugins\SAIN</SainDirectory>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <Reference Include="BepInEx" HintPath="$(SptRoot)\BepInEx\core\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(SptRoot)\BepInEx\core\0Harmony.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(SptRoot)\EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="SAIN" HintPath="$(SainDirectory)\SAIN.dll" Private="false" />
    <Reference Include="SAIN.Preset.Shared" HintPath="$(SainDirectory)\SAIN.Preset.Shared.dll" Private="false" />
  </ItemGroup>
</Project>
